{
  "name": "prep-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "frontend": "npm run dev --prefix frontend",
    "backend": "cd backend && python main.py",
    "dev": "concurrently \"npm run frontend\" \"npm run backend\"",
    "install-all": "npm install --prefix frontend && cd backend && pip install -r requirements.txt"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
